<Window x:Class="LingoIsland.Present.NotesImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="匯入清單" Width="640" Height="460"
        MinWidth="520" MinHeight="320"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource PinkBg}">
  <!-- [modHmi筆記匯入確認頁]（spec#14，#309）：預掃描彙總確認表——逐列核取（新字預設勾、已在筆記預設不勾、檔內重複不可勾）、
       全選新字／全不選、來源欄與未納入行（#320）、有自備中譯時之中譯來源欄與整批「也改查線上」（#321）、費用揭露、主鈕「查詢並加入 N 字」（N＝勾選數、0 停用）、取消（Esc 同）。確認前零 AI 呼叫。 -->
  <Border Style="{StaticResource Card}" Margin="12" Padding="12">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Margin="0,0,0,8">
        <TextBlock x:Name="HeaderText" TextWrapping="Wrap" FontSize="12.5"
                   Foreground="{StaticResource PinkText}"/>
        <!-- #320：未納入之檔（非 txt／csv、資料夾、讀不到、亂碼、沒有字）；無則 Collapsed 不佔位 -->
        <TextBlock x:Name="ExcludedText" TextWrapping="Wrap" FontSize="11.5" Margin="0,4,0,0" Visibility="Collapsed"
                   Foreground="#A06A20" AutomationProperties.AutomationId="NotesImportExcluded"/>
      </StackPanel>

      <DockPanel Grid.Row="1" Margin="0,0,0,6" LastChildFill="True">
        <Button x:Name="SelectNewBtn" DockPanel.Dock="Left" Content="全選新字" Style="{StaticResource GhostButton}"
                AutomationProperties.AutomationId="NotesImportSelectNew" Padding="10,3" Margin="0,0,6,0"
                ToolTip="只勾選狀態為「新字」的列"/>
        <Button x:Name="SelectNoneBtn" DockPanel.Dock="Left" Content="全不選" Style="{StaticResource GhostButton}"
                AutomationProperties.AutomationId="NotesImportSelectNone" Padding="10,3"
                ToolTip="取消所有勾選（之後可逐列再勾）"/>
        <!-- #321：有自備中譯（csv 第二欄）時才顯示——整批改為線上查詢 -->
        <CheckBox x:Name="ForceOnlineBox" DockPanel.Dock="Left" Content="有自備中譯的字也改查線上" FontSize="11.5"
                  Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" Foreground="{StaticResource PinkText}"
                  AutomationProperties.AutomationId="NotesImportForceOnline"
                  ToolTip="勾選＝不採用 csv 第二欄的自備中譯、全部上網查（取得 AI 的音標與翻譯，會花費用）；取消勾選即恢復"/>
        <TextBlock x:Name="SummaryText" FontSize="11.5" Foreground="{StaticResource PinkSub}"
                   HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="8,0,0,0"/>
      </DockPanel>

      <Border Grid.Row="2" BorderBrush="{StaticResource PinkAccent}" BorderThickness="1" CornerRadius="6" Background="#99FFFFFF">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Grid Grid.Row="0" Background="{StaticResource PinkTint}" Margin="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="34"/>
              <ColumnDefinition Width="200"/>
              <ColumnDefinition Width="130"/>
              <ColumnDefinition x:Name="TranslationHeaderColumn" Width="0"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="勾" FontSize="11" Margin="8,4" Foreground="{StaticResource PinkText}"/>
            <TextBlock Grid.Column="1" Text="單字／片語" FontSize="11" Margin="4,4" Foreground="{StaticResource PinkText}"/>
            <TextBlock Grid.Column="2" Text="來源" FontSize="11" Margin="4,4" Foreground="{StaticResource PinkText}"/>
            <TextBlock Grid.Column="3" x:Name="TranslationHeader" Text="中譯來源" FontSize="11" Margin="4,4" Foreground="{StaticResource PinkText}" Visibility="Collapsed"/>
            <TextBlock Grid.Column="4" Text="狀態" FontSize="11" Margin="8,4,12,4" Foreground="{StaticResource PinkText}"/>
          </Grid>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="RowsPanel" Margin="0,2"/>
          </ScrollViewer>
        </Grid>
      </Border>

      <TextBlock Grid.Row="3" x:Name="CostText" TextWrapping="Wrap" FontSize="12" Margin="0,10,0,0"
                 Foreground="#B0578D"/>

      <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
        <Button x:Name="ConfirmBtn" Style="{StaticResource PinkButton}" MinWidth="150" Margin="0,0,8,0" IsDefault="True"
                AutomationProperties.AutomationId="NotesImportConfirm"/>
        <Button x:Name="CancelBtn" Content="取消" Style="{StaticResource GhostButton}" MinWidth="88" IsCancel="True"
                AutomationProperties.AutomationId="NotesImportCancel"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
